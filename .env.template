NODE_ENV=development

# Gestión de imágenes (producto, empleado, establecimiento)
# IMAGE_STORAGE_MODE fuerza 'local' o 'cloud'. Si no se define, se autodetecta:
# existe process.env.VERCEL -> cloud, si no -> local.
IMAGE_STORAGE_MODE=
# Carpeta destino relativa dentro de /storage (NO /public) para el modo local (default: uploads).
# Se sirve vía src/app/uploads/[...path]/route.ts, no como archivo estático.
LOCAL_IMAGE_STORAGE_PATH=uploads
# Credenciales de Cloudinary (modo cloud)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Procesamiento automático (compresión/redimensionado) de imágenes subidas,
# comportamiento tipo WhatsApp/Facebook: la foto se sube tal cual y el backend
# la re-comprime de forma transparente. Ver spect/01_gestion_imagenes_spect.md,
# sección 4 "Procesamiento automático de imágenes".
# Límite duro de subida cruda, anti-abuso, aplicado ANTES de procesar (default 15MB).
MAX_RAW_UPLOAD_SIZE_MB=15
# Umbral de tamaño crudo a partir del cual se dispara la compresión/redimensionado
# automático (default 1024KB = 1MB). Por debajo de este umbral, el archivo se
# guarda tal cual, sin re-codificar.
IMAGE_COMPRESSION_THRESHOLD_KB=1024
# Dimensión máxima (lado mayor) a la que se redimensiona manteniendo aspect ratio (default 1920).
IMAGE_MAX_DIMENSION_PX=1920
# Calidad de re-encode, escala 1-100 (default 80).
IMAGE_COMPRESSION_QUALITY=80
# Formato al que se homogeniza la salida cuando se comprime (default webp).
IMAGE_OUTPUT_FORMAT=webp
# Cota de seguridad post-procesamiento; si el resultado la excede, se rechaza (default 3MB).
MAX_PROCESSED_IMAGE_SIZE_MB=3